// Phase 7 v4 arch test harness.
//
// Instantiates heliodor_core with a private 1 MB DRAM at PA
// 0x80000000 and the standard riscv-tests tohost protocol (PA
// 0x80001000 == word index 1024 of the 32-bit DRAM array):
//   tohost == 1  → all subtests passed
//   tohost  > 1  → subtest with that ID failed
//
// rv64ui-* tests run M-mode, no MMU, just need DRAM + tohost.
module test_arch_common_harness #(
    param HEX_FILE  : string = ""  ,
    param TOHOST_IDX: u32    = 1024,
    // P10 Sstc: when 1, drive i_mtime from a free-running per-cycle counter so
    // the supervisor timer (stimecmp) can fire. Default 0 keeps i_mtime == 0
    // for every existing arch test (byte-identical behaviour).
    param MTIME_EN  : bit    = 1'b0,
    param RETIRE_PC: logic<64> = 64'd0,
) (
    clk     : input  clock    ,
    rst     : input  reset    ,
    o_pass  : output logic    ,
    o_fail  : output logic    ,
    o_tohost: output logic<32>,
    o_retire_count: output logic<32>,
    o_retire_pc: output logic<64>,
    o_retire_rd_valid: output logic,
    o_retire_rd: output logic<5>,
    o_retire_data: output logic<64>,
    o_ld_probe_req: output logic,
    o_ld_probe_hit: output logic,
    o_ld_probe_miss: output logic,
    o_ld_probe_priv: output logic<2>,
    o_ld_probe_satp: output logic<64>,
    o_ld_probe_vaddr: output logic<64>,
    o_ld_probe_paddr: output logic<64>,
    o_ld_probe_acc_fault: output logic,
    o_ld_probe_page_fault: output logic,
    o_ld_probe_uncached: output logic,
) {
    // P10 Sstc: free-running mtime counter (only advances when MTIME_EN).
    var mtime_ctr: logic<64>;
    always_ff (clk, rst) {
        if_reset {
            mtime_ctr = 64'd0;
        } else if MTIME_EN {
            mtime_ctr = mtime_ctr + 64'd1;
        }
    }
    var imem_addr        : logic<64>     ;
    var imem_rdata       : logic<32>     ;
    var imem_ren         : logic         ;
    var iptw_addr        : logic<64>     ; // M8.C: instruction-PTW bus
    var iptw_rdata       : logic<64>     ;
    var dmem_addr        : logic<64>     ;
    var dmemw_addr        : logic<64>     ; // S23: write-channel address
    var dmem_wdata       : logic<64> [8] ; // S25: write-channel line lanes
    var dmem_rdata       : logic<64>     ;
    var dmem_rdata_next  : logic<64>     ;
    var dmem_wen         : logic         ;
    var dmem_ren         : logic         ;
    var dmem_wstrb       : logic<8>  [8] ;
    var dmem_wdata_hi    : logic<64>     ;
    var dmem_wstrb_hi    : logic<8>      ;
    var dbg_pc           : logic<64>     ;
    var dbg_regs         : logic<64> [32];
    var ret_v            : logic         ;
    var ret_pc           : logic<64>     ;
    var ret_rdv          : logic         ;
    var ret_rd           : logic<5>      ;
    var ret_data         : logic<64>     ;
    var probe_count: logic<32>;
    var probe_pc: logic<64>;
    var probe_rd_valid: logic;
    var probe_rd: logic<5>;
    var probe_data: logic<64>;
    var ld_probe_req: logic;
    var ld_probe_hit: logic;
    var ld_probe_miss: logic;
    var ld_probe_priv: logic<2>;
    var ld_probe_satp: logic<64>;
    var ld_probe_vaddr: logic<64>;
    var ld_probe_paddr: logic<64>;
    var ld_probe_acc_fault: logic;
    var ld_probe_page_fault: logic;
    var ld_probe_uncached: logic;
    var dbg_rename_cnt   : logic<32>     ;
    var dbg_cdb_cnt      : logic<32>     ;
    var dbg_rob_size     : logic<8>      ;
    var dbg_if_v         : logic         ;
    var dbg_if_instr     : logic<32>     ;
    var dbg_stall_dr     : logic         ;
    var dbg_head_valid   : logic         ;
    var dbg_head_rw      : logic         ;
    var dbg_head_il      : logic         ;
    var dbg_r_alloc      : logic<32>     ;
    var dbg_r_cdb        : logic<32>     ;
    var dbg_r_commit     : logic<32>     ;
    var dbg_r_head       : logic<6>      ;
    var dbg_r_tail       : logic<6>      ;
    var _dbg_sepc        : logic<64>     ;
    var _dbg_mepc        : logic<64>     ;
    var _dbg_priv        : logic<2>      ;
    var _dbg_trap_fire   : logic         ;
    var _dbg_trap_pc     : logic<64>     ;
    var _dbg_trap_cause  : logic<64>     ;
    var _dbg_trap_to_s   : logic         ;
    var _dbg_satp        : logic<64>     ;
    var _dbg_ld_probe_vaddr: logic<64>;
    var _dbg_ld_probe_paddr: logic<64>;
    var _dbg_ld_probe_acc_fault: logic;
    var _dbg_ld_probe_page_fault: logic;
    var _dbg_ld_probe_uncached: logic;
    always_ff (clk, rst) {
        if_reset { probe_count = 32'd0; probe_pc = 64'd0; probe_rd_valid = 1'b0; probe_rd = 5'd0; probe_data = 64'd0; ld_probe_priv = 2'd0; ld_probe_satp = 64'd0; ld_probe_vaddr = 64'd0; ld_probe_paddr = 64'd0; ld_probe_acc_fault = 1'b0; ld_probe_page_fault = 1'b0; ld_probe_uncached = 1'b0; }
        else {
            if ret_v && ret_pc == RETIRE_PC { probe_count = probe_count + 32'd1; probe_pc = ret_pc; probe_rd_valid = ret_rdv; probe_rd = ret_rd; probe_data = ret_data; }
            if ld_probe_req { ld_probe_priv = _dbg_priv; ld_probe_satp = _dbg_satp; ld_probe_vaddr = _dbg_ld_probe_vaddr; ld_probe_paddr = _dbg_ld_probe_paddr; ld_probe_acc_fault = _dbg_ld_probe_acc_fault; ld_probe_page_fault = _dbg_ld_probe_page_fault; ld_probe_uncached = _dbg_ld_probe_uncached; }
        }
    }
    var _dbg_imem_vaddr  : logic<64>     ;
    var _dbg_imem_paddr  : logic<64>     ;
    var _dbg_imem_valid  : logic         ;
    var _dbg_imem_fault  : logic         ;
    var _dbg_csrwr_v     : logic         ;
    var _dbg_csrwr_addr  : logic<12>     ;
    var _dbg_csrwr_wdata : logic<64>     ;
    var _dbg_ptw_req     : logic         ;
    var _dbg_ptw_addr    : logic<64>     ;
    var _dbg_ptw_data    : logic<64>     ;
    var _dbg_redir_v     : logic         ;
    var _dbg_redir_pc    : logic<64>     ;
    var _dbg_redir_src   : logic<64>     ;
    var _dbg_alu_pc      : logic<64>     ;
    var _dbg_alu_src_a   : logic<64>     ;
    var _dbg_alu_src_b   : logic<64>     ;
    var _dbg_alu_use_pc_a: logic         ;

    inst dut: heliodor_core #(
        RESET_PC : 64'h80000000,
        // ACT4 compliance: fault PA outside DRAM/CLINT/UART/PLIC (PMPSm
        // cfg_A_tor_zero, ExceptionsSv*). The arch map has no low ROM.
        PMA_FAULT: 1           ,
        LD_PROBE_PC: RETIRE_PC,
    ) (
        clk                                      ,
        rst                                      ,
        o_imem_addr           : imem_addr        ,
        i_imem_rdata          : imem_rdata       ,
        o_imem_ren            : imem_ren         ,
        o_iptw_addr           : iptw_addr        ,
        o_iptw_req            : _                ,
        i_iptw_rdata          : iptw_rdata       ,
        o_dmem_addr           : dmem_addr        ,
        o_dmem_wdata          : dmem_wdata       ,
        i_dmem_rdata          : dmem_rdata       ,
        i_dmem_rdata_next     : dmem_rdata_next  ,
        o_dmem_wen            : dmem_wen         ,
        o_dmem_ren            : dmem_ren         ,
        o_dmem_wstrb          : dmem_wstrb       ,
        o_dmemw_addr        : dmemw_addr      , // S23: write channel
        o_dmemw_req         : _               ,
        i_dmemw_grant       : 1'b1            ,
        o_dmem_wdata_hi       : dmem_wdata_hi    ,
        o_dmem_wstrb_hi       : dmem_wstrb_hi    ,
        o_dmem_req            : _    ,
        i_dmem_grant          : 1'b1 ,
        i_dcache_inv_valid    : 1'b0 ,
        i_dcache_inv_addr     : 64'd0,
        i_dcache_inv2_valid     : 1'b0 ,
        i_dcache_inv2_addr      : 64'd0,
        o_dmemw_wb      : _,
        o_dmem_rfo      : _,
        i_dmem_fill_excl     : 1'b1,
        i_dcache_probe_v      : 1'b0,
        i_dcache_probe_self     : 1'b0,
        i_dcache_probe_addr     : 64'd0,
        o_dcache_probe_ack      : _,
        i_irq_timer_m         : 1'b0             ,
        i_irq_sw_m            : 1'b0             ,
        i_irq_ext_m           : 1'b0             ,
        i_irq_ext_s           : 1'b0             ,
        i_mtime               : mtime_ctr        ,
        o_dbg_pc              : dbg_pc           ,
        o_dbg_regs            : dbg_regs         ,
        o_dbg_retire_v_a      : ret_v            ,
        o_dbg_retire_pc_a     : ret_pc           ,
        o_dbg_retire_rd_v_a   : ret_rdv          ,
        o_dbg_retire_rd_a     : ret_rd           ,
        o_dbg_retire_data_a   : ret_data         ,
        o_dbg_ld_probe_req: ld_probe_req,
        o_dbg_ld_probe_hit: ld_probe_hit,
        o_dbg_ld_probe_miss: ld_probe_miss,
        o_dbg_ld_probe_vaddr: _dbg_ld_probe_vaddr,
        o_dbg_ld_probe_paddr: _dbg_ld_probe_paddr,
        o_dbg_ld_probe_acc_fault: _dbg_ld_probe_acc_fault,
        o_dbg_ld_probe_page_fault: _dbg_ld_probe_page_fault,
        o_dbg_ld_probe_uncached: _dbg_ld_probe_uncached,
        o_dbg_rename_cnt      : dbg_rename_cnt   ,
        o_dbg_cdb_cnt         : dbg_cdb_cnt      ,
        o_dbg_rob_size        : dbg_rob_size     ,
        o_dbg_if_v            : dbg_if_v         ,
        o_dbg_if_instr        : dbg_if_instr     ,
        o_dbg_stall_dr        : dbg_stall_dr     ,
        o_dbg_head_valid      : dbg_head_valid   ,
        o_dbg_head_rw         : dbg_head_rw      ,
        o_dbg_head_illegal    : dbg_head_il      ,
        o_dbg_rob_alloc_cnt   : dbg_r_alloc      ,
        o_dbg_rob_cdb_cnt     : dbg_r_cdb        ,
        o_dbg_rob_commit_cnt  : dbg_r_commit     ,
        o_dbg_rob_head        : dbg_r_head       ,
        o_dbg_rob_tail        : dbg_r_tail       ,
        o_dbg_sepc            : _dbg_sepc        ,
        o_dbg_mepc            : _dbg_mepc        ,
        o_dbg_priv            : _dbg_priv        ,
        o_dbg_trap_fire       : _dbg_trap_fire   ,
        o_dbg_trap_pc         : _dbg_trap_pc     ,
        o_dbg_trap_cause      : _dbg_trap_cause  ,
        o_dbg_trap_to_s       : _dbg_trap_to_s   ,
        o_dbg_satp            : _dbg_satp        ,
        o_dbg_imem_vaddr      : _dbg_imem_vaddr  ,
        o_dbg_imem_paddr      : _dbg_imem_paddr  ,
        o_dbg_imem_valid      : _dbg_imem_valid  ,
        o_dbg_imem_fault      : _dbg_imem_fault  ,
        o_dbg_csrwr_v         : _dbg_csrwr_v     ,
        o_dbg_csrwr_addr      : _dbg_csrwr_addr  ,
        o_dbg_csrwr_wdata     : _dbg_csrwr_wdata ,
        o_dbg_ptw_req         : _dbg_ptw_req     ,
        o_dbg_ptw_addr        : _dbg_ptw_addr    ,
        o_dbg_ptw_data        : _dbg_ptw_data    ,
        o_dbg_redirect_fire   : _dbg_redir_v     ,
        o_dbg_redirect_pc     : _dbg_redir_pc    ,
        o_dbg_redirect_src_pc : _dbg_redir_src   ,
        o_dbg_alu_pc_out      : _dbg_alu_pc      ,
        o_dbg_alu_src_a_out   : _dbg_alu_src_a   ,
        o_dbg_alu_src_b_out   : _dbg_alu_src_b   ,
        o_dbg_alu_use_pc_a_out: _dbg_alu_use_pc_a,
        o_dbg_alu_rs1_data_out: _                ,
        o_dbg_alu_valid_out   : _                ,
        o_dbg_alu_alu_out_out : _                ,
        o_dbg_alu_instr_out   : _                ,
        o_dbg_alu_imm_out     : _                ,
        o_dbg_stval_out       : _                ,
        o_dbg_mtval_out       : _                ,
    );

    // 4 MB DRAM at PA 0x80000000. The rv64ui-* tests fit in the low 256 KB,
    // but the larger ACT4 (riscv-arch-test) suites (e.g. I-beq/jal, ~67 k words)
    // place their boot/HALT trampoline (.text.rvmodel) above 256 KB, so the
    // backing array must be big enough to hold the whole image (addr[21:2]).
    // Existing tests only touch addr < 0x40000, so the low index bits are
    // unchanged and behaviour stays byte-identical.
    #[allow(initial_assign)]
    var dram: logic<32> [1048576];
    initial {
        $readmemh(HEX_FILE, dram);
    }

    let in_dram: logic = dmem_addr[31];

    let in_dram_w : logic = dmemw_addr[31]; // S23
    // M8: simple UART MMIO at 0x10000000. A byte STORE to 0x10000000
    // prints to $write; reads return 0 (no IIR/LSR yet). This is enough
    // for putc-style bare-metal output from rv64-arch tests that exercise
    // simple SoC plumbing.
    let in_uart      : logic     = dmem_addr[31:28] == 4'h1;
    let in_uart_wch: logic = dmemw_addr[31:28] == 4'h1; // S23
    let dram_imem_idx: logic<20> = imem_addr[21:2];
    let dram_dmem_lo : logic<20> = {dmem_addr[21:3], 1'b0};
    let dram_dmem_hi : logic<20> = {dmem_addr[21:3], 1'b1};
    // M8: dword+1 indices for the next-dword combinational read
    let dram_dmem_nx_lo: logic<20> = {(dmem_addr[21:3] + 19'd1), 1'b0};
    let dram_dmem_nx_hi: logic<20> = {(dmem_addr[21:3] + 19'd1), 1'b1};
    // S23: write-channel DRAM indices (independent address; S25: the lanes
    // carry the dword offsets, only the misaligned hi-side keeps dword+1).
    let dram_dmw_nx_lo: logic<20> = {(dmemw_addr[21:3] + 19'd1), 1'b0};
    let dram_dmw_nx_hi: logic<20> = {(dmemw_addr[21:3] + 19'd1), 1'b1};
    assign imem_rdata      = if imem_addr[31] ? dram[dram_imem_idx] : 32'd0;
    assign dmem_rdata      = if in_dram ? {dram[dram_dmem_hi], dram[dram_dmem_lo]} : 64'd0;
    assign dmem_rdata_next = if in_dram ? {dram[dram_dmem_nx_hi], dram[dram_dmem_nx_lo]} : 64'd0;
    // M8.C: instruction-PTW PTE read (64-bit dword), same dram, combinational.
    let dram_iptw_lo: logic<20> = {iptw_addr[21:3], 1'b0};
    let dram_iptw_hi: logic<20> = {iptw_addr[21:3], 1'b1};
    assign iptw_rdata = if iptw_addr[31] ? {dram[dram_iptw_hi], dram[dram_iptw_lo]} : 64'd0;

    // S25: an MMIO/slow store is a one-lane line write; pick its dword.
    let uart_w_lane: logic<3>  = dmemw_addr[5:3];
    let uart_wdata : logic<64> = dmem_wdata[uart_w_lane];
    let uart_wstrb : logic<8>  = dmem_wstrb[uart_w_lane];
    always_ff (clk, rst) {
        if_reset {} else if dmem_wen && in_dram_w {
            // S25: line write — merge every populated lane.
            for l in 0..8 {
                if dmem_wstrb[l] != 8'd0 {
                    let w_lo : logic<20> = {dmemw_addr[21:6], l as 3, 1'b0};
                    let w_hi : logic<20> = {dmemw_addr[21:6], l as 3, 1'b1};
                    let w_old: logic<64> = {dram[w_hi], dram[w_lo]};
                    let w_new: logic<64> = {
                        if dmem_wstrb[l][7] ? dmem_wdata[l][63:56] : w_old[63:56],
                        if dmem_wstrb[l][6] ? dmem_wdata[l][55:48] : w_old[55:48],
                        if dmem_wstrb[l][5] ? dmem_wdata[l][47:40] : w_old[47:40],
                        if dmem_wstrb[l][4] ? dmem_wdata[l][39:32] : w_old[39:32],
                        if dmem_wstrb[l][3] ? dmem_wdata[l][31:24] : w_old[31:24],
                        if dmem_wstrb[l][2] ? dmem_wdata[l][23:16] : w_old[23:16],
                        if dmem_wstrb[l][1] ? dmem_wdata[l][15:8] : w_old[15:8],
                        if dmem_wstrb[l][0] ? dmem_wdata[l][7:0] : w_old[7:0]
                    };
                    dram[w_lo] = w_new[31:0];
                    dram[w_hi] = w_new[63:32];
                }
            }
            // M8 hi-half: misalign STORE carry into next dword
            if dmem_wstrb_hi[0] {
                dram[dram_dmw_nx_lo][7:0]   = dmem_wdata_hi[7:0];
            }
            if dmem_wstrb_hi[1] {
                dram[dram_dmw_nx_lo][15:8]  = dmem_wdata_hi[15:8];
            }
            if dmem_wstrb_hi[2] {
                dram[dram_dmw_nx_lo][23:16] = dmem_wdata_hi[23:16];
            }
            if dmem_wstrb_hi[3] {
                dram[dram_dmw_nx_lo][31:24] = dmem_wdata_hi[31:24];
            }
            if dmem_wstrb_hi[4] {
                dram[dram_dmw_nx_hi][7:0]   = dmem_wdata_hi[39:32];
            }
            if dmem_wstrb_hi[5] {
                dram[dram_dmw_nx_hi][15:8]  = dmem_wdata_hi[47:40];
            }
            if dmem_wstrb_hi[6] {
                dram[dram_dmw_nx_hi][23:16] = dmem_wdata_hi[55:48];
            }
            if dmem_wstrb_hi[7] {
                dram[dram_dmw_nx_hi][31:24] = dmem_wdata_hi[63:56];
            }
        } else if dmem_wen && in_uart_wch {
            // UART tx: print the byte STORE landed (bytes shifted in the
            // lane dword by addr[2:0]); pick the active byte via wstrb.
            if uart_wstrb[0] {
                $write("%c", uart_wdata[7:0]);
            }
            if uart_wstrb[1] {
                $write("%c", uart_wdata[15:8]);
            }
            if uart_wstrb[2] {
                $write("%c", uart_wdata[23:16]);
            }
            if uart_wstrb[3] {
                $write("%c", uart_wdata[31:24]);
            }
            if uart_wstrb[4] {
                $write("%c", uart_wdata[39:32]);
            }
            if uart_wstrb[5] {
                $write("%c", uart_wdata[47:40]);
            }
            if uart_wstrb[6] {
                $write("%c", uart_wdata[55:48]);
            }
            if uart_wstrb[7] {
                $write("%c", uart_wdata[63:56]);
            }
        }
    }

    let tohost_lo: logic<32> = dram[TOHOST_IDX[19:0]];
    assign o_tohost = tohost_lo;
    assign o_retire_count = probe_count;
    assign o_retire_pc = probe_pc;
    assign o_retire_rd_valid = probe_rd_valid;
    assign o_retire_rd = probe_rd;
    assign o_retire_data = probe_data;
    assign o_ld_probe_req = ld_probe_req;
    assign o_ld_probe_hit = ld_probe_hit;
    assign o_ld_probe_miss = ld_probe_miss;
    assign o_ld_probe_priv = ld_probe_priv;
    assign o_ld_probe_satp = ld_probe_satp;
    assign o_ld_probe_vaddr = ld_probe_vaddr;
    assign o_ld_probe_paddr = ld_probe_paddr;
    assign o_ld_probe_acc_fault = ld_probe_acc_fault;
    assign o_ld_probe_page_fault = ld_probe_page_fault;
    assign o_ld_probe_uncached = ld_probe_uncached;
    assign o_pass   = tohost_lo == 32'd1;
    assign o_fail   = tohost_lo[0] == 1'b0 && tohost_lo != 32'd0;
}

#[test(test_arch_rv64ui_ld)]
module test_arch_rv64ui_ld {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );
    var pass  : logic    ;
    var fail  : logic    ;
    var tohost: logic<32>;
    var retire_count: logic<32>;
    var retire_pc: logic<64>;
    var retire_rd_valid: logic;
    var retire_rd: logic<5>;
    var retire_data: logic<64>;
    var ld_probe_req: logic;
    var ld_probe_hit: logic;
    var ld_probe_miss: logic;
    var ld_probe_priv: logic<2>;
    var ld_probe_satp: logic<64>;
    var ld_probe_vaddr: logic<64>;
    var ld_probe_paddr: logic<64>;
    var ld_probe_acc_fault: logic;
    var ld_probe_page_fault: logic;
    var ld_probe_uncached: logic;
    var ld_probe_req_seen: logic;
    var ld_probe_hit_seen: logic;
    var ld_probe_miss_seen: logic;
    always_ff (clk, rst) {
        if_reset { ld_probe_req_seen = 1'b0; ld_probe_hit_seen = 1'b0; ld_probe_miss_seen = 1'b0; }
        else {
            if ld_probe_req { ld_probe_req_seen = 1'b1; }
            if ld_probe_hit { ld_probe_hit_seen = 1'b1; }
            if ld_probe_miss { ld_probe_miss_seen = 1'b1; }
        }
    }
    inst h: test_arch_common_harness #(
        HEX_FILE  : "experiments/heliodor-smoke/ld-heliodor-pma-fault.hex",
        TOHOST_IDX: 1024, RETIRE_PC: 64'h0000000080000010,
    ) (
        clk                                                   ,
        rst                                                   ,
        o_pass    : pass                                      ,
        o_fail    : fail                                      ,
        o_tohost  : tohost                                    ,
        o_retire_count: retire_count, o_retire_pc: retire_pc, o_retire_rd_valid: retire_rd_valid, o_retire_rd: retire_rd, o_retire_data: retire_data,
        o_ld_probe_req: ld_probe_req, o_ld_probe_hit: ld_probe_hit, o_ld_probe_miss: ld_probe_miss,
        o_ld_probe_priv: ld_probe_priv, o_ld_probe_satp: ld_probe_satp,
        o_ld_probe_vaddr: ld_probe_vaddr, o_ld_probe_paddr: ld_probe_paddr,
        o_ld_probe_acc_fault: ld_probe_acc_fault, o_ld_probe_page_fault: ld_probe_page_fault, o_ld_probe_uncached: ld_probe_uncached,
    );
    initial {
        rst.assert(clk);
        clk.next  (300000);
        $display  ("v4 rv64ui-ld tohost=%h pass=%b", tohost, pass);
    $display ("ld-retire count=%h pc=%h rd_valid=%h rd=%h data=%h", retire_count, retire_pc, retire_rd_valid, retire_rd, retire_data);
    $display ("ld-cache-probe req=%b hit=%b miss=%b", ld_probe_req_seen, ld_probe_hit_seen, ld_probe_miss_seen);
    $display ("ld-context priv=%h satp=%h", ld_probe_priv, ld_probe_satp);
    $display ("ld-address vaddr=%h paddr=%h", ld_probe_vaddr, ld_probe_paddr);
    $display ("ld-check acc_fault=%b page_fault=%b uncached=%b", ld_probe_acc_fault, ld_probe_page_fault, ld_probe_uncached);
        $assert   (pass, "v4 rv64ui-ld fail");
        $display  ("v4 rv64ui-ld PASS");
        $finish   ();
    }
}
